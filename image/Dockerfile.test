ARG BASE_IMAGE=debian:trixie
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# Keep the tool layer independent of the app package, stages and test scripts.
# The pinned pi-gen checkout is mounted read-only at run time.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git vim parted quilt coreutils qemu-user debootstrap zerofree zip \
    dosfstools e2fsprogs libarchive-tools libcap2-bin rsync grep udev \
    xz-utils curl xxd file kmod bc ca-certificates fdisk gpg pigz arch-test \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /
VOLUME ["/pi-gen/work", "/pi-gen/deploy"]
