# Isolated ARM64 Raspberry Pi 4B test image with Openstreamer runtime identifiers.
IMG_NAME=Openstreamer
RELEASE=trixie
STAGE_LIST="stage0 stage1 stage2 stage-openstreamer"
DEPLOY_COMPRESSION=xz
COMPRESSION_LEVEL=3
TARGET_HOSTNAME=openstreamer
FIRST_USER_NAME=openstreamer
FIRST_USER_PASS=openstreamer
DISABLE_FIRST_BOOT_USER_RENAME=1
ENABLE_SSH=0
LOCALE_DEFAULT=en_US.UTF-8
KEYBOARD_KEYMAP=us
KEYBOARD_LAYOUT="English (US)"
TIMEZONE_DEFAULT=Etc/UTC
CLEAN=1
