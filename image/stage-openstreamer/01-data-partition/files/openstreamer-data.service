[Unit]
Description=Openstreamer data partition
# Needs the block devices and a writable system partition, and has to be done
# before Openstreamer reads its settings
After=systemd-remount-fs.service systemd-udev-settle.service local-fs.target
Before=openstreamer.service
ConditionPathExists=/etc/openstreamer/image

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/openstreamer/openstreamer-data
# Formatting a large card takes a while the first time
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
