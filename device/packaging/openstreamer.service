[Unit]
Description=Openstreamer
# openstreamer-data only exists on the image, where it puts the settings and
# recordings on their own partition first
After=NetworkManager.service systemd-modules-load.service openstreamer-data.service
Wants=NetworkManager.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/openstreamer run
SyslogIdentifier=openstreamer
# Re-reads the login, after `openstreamer password`
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
# Settings and recordings; created if missing, kept on removal
ConfigurationDirectory=openstreamer
StateDirectory=openstreamer
# Finishing an open recording can take a few seconds
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
